<%- include('../partials/doc-info') %>

<!DOCTYPE html>
<html lang="<%= lang %>" data-hx-boost="true">
    <head>
        <%- include('../partials/head', {
            html_title: t.about.html_title
        }) %>
    </head>
    <body>
        <main class="flex flex-col">
            <%- include('../partials/alert', { alert }) %>
            <!-- prettier-ignore -->
            <%- include('../partials/header', {
                title: t.about.title,
                subtitle: t.about.subtitle
            }) %>

            <section class="w-full max-w-7xl mx-auto px-8 py-16">
                <div>
                    <p class="text-lg leading-8"><%= t.about.intro %></p>

                    <ul class="pl-8 text-lg pt-4 list-disc space-y-4">
                        <% for (const item of t.about.expertise) { %>
                        <li><%= item %></li>
                        <% } %>
                    </ul>

                    <p class="text-lg leading-8 mt-8"><%= t.about.projects_intro %></p>

                    <ul class="pl-8 text-lg pt-4 list-disc space-y-4">
                        <% for (const item of t.about.projects) { %>
                        <li><%= item %></li>
                        <% } %>
                    </ul>

                    <p class="text-lg leading-8 mt-4">
                        <%= t.about.not_listed_before %>
                        <a href="<%= url('/hafa-samband') %>" class="at--custom-link"><%= t.about.not_listed_link %></a>
                        <%= t.about.not_listed_after %>
                    </p>

                    <p class="text-lg leading-8 mt-8"><%= t.about.name_origin %></p>

                    <div class="border-l-4 border-red-500 p-3 mt-8 flex gap-2 bg-gray-50">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-5 shrink-0 mt-0.5">
                            <path
                                d="M320 576C178.6 576 64 461.4 64 320C64 178.6 178.6 64 320 64C461.4 64 576 178.6 576 320C576 461.4 461.4 576 320 576zM320 384C302.3 384 288 398.3 288 416C288 433.7 302.3 448 320 448C337.7 448 352 433.7 352 416C352 398.3 337.7 384 320 384zM320 192C301.8 192 287.3 207.5 288.6 225.7L296 329.7C296.9 342.3 307.4 352 319.9 352C332.5 352 342.9 342.3 343.8 329.7L351.2 225.7C352.5 207.5 338.1 192 319.8 192z"
                            />
                        </svg>

                        <span><%= t.about.disclaimer %></span>
                    </div>
                </div>
            </section>

            <%- include('../partials/cta') %>

            <%- include('../partials/footer') %>
        </main>

        <%- include('../partials/scripts') %>
    </body>
</html>
