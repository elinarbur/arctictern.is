<%- include('../partials/doc-info') %>
<% const page = t.service_pages[service.key] %>

<!DOCTYPE html>
<html lang="<%= lang %>" data-hx-boost="true">
    <head>
        <%- include('../partials/head', {
            html_title: page.html_title
        }) %>
    </head>
    <body>
        <main class="flex flex-col">
            <%- include('../partials/alert', { alert }) %>
            <!-- prettier-ignore -->
            <%- include('../partials/header', {
                title: page.title,
                subtitle: page.subtitle
            }) %>

            <section class="w-full max-w-7xl mx-auto px-8 py-16">
                <div>
                    <a href="<%= url('/thjonusta') %>" class="inline-flex items-center gap-1 font-medium at--custom-link">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" class="size-4 rotate-180">
                            <path
                                d="M535.1 342.6C547.6 330.1 547.6 309.8 535.1 297.3L375.1 137.3C362.6 124.8 342.3 124.8 329.8 137.3C317.3 149.8 317.3 170.1 329.8 182.6L467.2 320L329.9 457.4C317.4 469.9 317.4 490.2 329.9 502.7C342.4 515.2 362.7 515.2 375.2 502.7L535.2 342.7zM183.1 502.6L343.1 342.6C355.6 330.1 355.6 309.8 343.1 297.3L183.1 137.3C170.6 124.8 150.3 124.8 137.8 137.3C125.3 149.8 125.3 170.1 137.8 182.6L275.2 320L137.9 457.4C125.4 469.9 125.4 490.2 137.9 502.7C150.4 515.2 170.7 515.2 183.2 502.7z"
                            />
                        </svg>
                        <span><%= t.service_pages.all_services %></span>
                    </a>

                    <% for (const section of page.sections) { %>
                    <p class="text-lg leading-8 mt-8"><%= section.intro %></p>

                    <ul class="pl-8 text-lg pt-4 list-disc space-y-4">
                        <% for (const item of section.items) { %>
                        <li><%= item %></li>
                        <% } %>
                    </ul>
                    <% } %>

                    <p class="text-lg leading-8 mt-8">
                        <%= t.common.not_listed.before %>
                        <a href="<%= url('/hafa-samband') %>" class="at--custom-link"><%= t.common.not_listed.link %></a>
                        <%= t.common.not_listed.after %>
                    </p>
                </div>
            </section>

            <section class="w-full max-w-7xl mx-auto px-8 pb-16">
                <h2 class="text-xl font-semibold"><%= t.service_pages.other_services %></h2>

                <div class="pt-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <% for (const other of services.filter((s) => s.key !== service.key)) { %>
                    <a
                        href="<%= url(`/thjonusta/${other.slug}`) %>"
                        class="bg-gray-50 p-4 font-semibold transition-all duration-100 outline-4 outline-transparent hover:outline-yellow-300"
                    >
                        <%= t.services[other.key] %>
                    </a>
                    <% } %>
                </div>
            </section>

            <%- include('../partials/cta') %>

            <%- include('../partials/footer') %>
        </main>

        <%- include('../partials/scripts') %>
    </body>
</html>
